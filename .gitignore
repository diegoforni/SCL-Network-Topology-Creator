# Node / Bun — the guardrail plugin (images/*/guardrail/package.json) declares
# dev dependencies (@opencode-ai/plugin). A local `bun install` / `npm install`
# populates node_modules/ next to it; that must never be committed or land in a
# Docker build context.
node_modules/
.bun/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Saved topology state never belongs in the repo — starter topologies live in
# presets/ and are instantiated on demand (GET /api/presets,
# POST /api/presets/{id}/instantiate). Everything under data/topologies/ is
# runtime state: generated docker-compose.yml files embed the LIVE
# OPENCODE_API_KEY (resolve_run_id/compose.py stamp it from the environment),
# and pentest-target definitions ship as images, not as committed topology
# state. The blanket rule replaces the old per-family list so no new family
# can leak by forgetting to add a pattern.
/data/topologies/

# repo-server host: the external repo (e.g. accion_del_sur) is cloned at IMAGE
# BUILD time by the Docker daemon (see images/scl-repo-host/Dockerfile), so the
# third-party content is never committed here. This also guards against any
# local clone of that repo ever landing in the build context and being pushed.
# backend.env holds the app's runtime secrets (DB password, JWT, Stellar keys) —
# it is COPY'd into the image only and must NEVER be pushed.
/images/scl-repo-host/repo/
/images/scl-repo-host/.env
/images/scl-repo-host/backend.env
/images/scl-repo-host/*.env

# Topology env secrets stay out of the repo (covered by the blanket
# data/topologies/ rule above for the topology side)
/data/greedy.env

# Local backups / pre-edit snapshots of baked plugin sources
*.bak-*
*.before-*
