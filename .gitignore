.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Node / Bun — the guardrail plugin (images/*/guardrail/package.json) declares
# dev dependencies (@opencode-ai/plugin). A local `bun install` / `npm install`
# populates node_modules/ next to it; that must never be committed or land in a
# Docker build context.
node_modules/
.bun/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Scratch/test topologies generated by e2e runs (not real lab definitions)
/data/topologies/ditest*/
/data/topologies/frontend-create-test*/
/data/topologies/*-retest*/
/data/topologies/block-*/
/data/topologies/ds-burst-*/
/data/topologies/ds-eval-*/
/data/topologies/ds-gen-*/

# repo-server host: the external repo (e.g. accion_del_sur) is cloned at IMAGE
# BUILD time by the Docker daemon (see images/scl-repo-host/Dockerfile), so the
# third-party content is never committed here. This also guards against any
# local clone of that repo ever landing in the build context and being pushed.
# backend.env holds the app's runtime secrets (DB password, JWT, Stellar keys) —
# it is COPY'd into the image only and must NEVER be pushed.
/images/scl-repo-host/repo/
/images/scl-repo-host/.env
/images/scl-repo-host/backend.env
/images/scl-repo-host/*.env
